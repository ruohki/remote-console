#!/bin/sh
# remote-agent installer for macOS — generated by remote-console.
# Usage: curl -fsSL "{{SERVER_URL}}/install.sh?token=…" | sudo sh
set -eu

SERVER_URL="{{SERVER_URL}}"
TOKEN="{{TOKEN}}"
DOWNLOAD_BASE="{{DOWNLOAD_BASE}}"
USE_CONSOLE="{{USE_CONSOLE}}"
INSTALL_DIR="/usr/local/bin"
BINARY="$INSTALL_DIR/remote-agent"
ASSET="remote-agent-macos-universal"

log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
fail() { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

[ "$(uname -s)" = "Darwin" ] || fail "this installer is for macOS; use install.ps1 on Windows"
[ "$(id -u)" -eq 0 ] || fail "please run as root:  curl -fsSL \"$SERVER_URL/install.sh?token=$TOKEN\" | sudo sh"
command -v curl >/dev/null 2>&1 || fail "curl is required"

TMP="$(mktemp -d /tmp/remote-agent.XXXXXX)"
trap 'rm -rf "$TMP"' EXIT

APP_DIR=""
if [ "$USE_CONSOLE" = "1" ]; then
    log "Downloading branded agent app from $SERVER_URL"
    curl -fsSL --retry 3 -o "$TMP/agent.zip" "$SERVER_URL/api/agent/download/macos-universal?token=$TOKEN" \
        || fail "download failed from the console"
    mkdir -p "$TMP/app"
    ditto -x -k "$TMP/agent.zip" "$TMP/app" || fail "could not unpack the downloaded app"
    APP_SRC="$(find "$TMP/app" -maxdepth 1 -name '*.app' | head -n 1)"
    [ -n "$APP_SRC" ] || fail "downloaded archive contains no .app bundle"
    APP_DIR="/Applications/$(basename "$APP_SRC")"
    log "Installing $APP_DIR"
    if [ -x "$APP_DIR/Contents/MacOS/remote-agent" ]; then
        "$APP_DIR/Contents/MacOS/remote-agent" service stop >/dev/null 2>&1 || true
    fi
    rm -rf "$APP_DIR"
    ditto "$APP_SRC" "$APP_DIR" || fail "could not copy the app to /Applications"
    xattr -dr com.apple.quarantine "$APP_DIR" >/dev/null 2>&1 || true
    # Keep the CLI reachable as `remote-agent`.
    mkdir -p "$INSTALL_DIR"
    ln -sfn "$APP_DIR/Contents/MacOS/remote-agent" "$BINARY"
else
    log "Downloading $ASSET from $DOWNLOAD_BASE"
    curl -fsSL --retry 3 -o "$TMP/$ASSET" "$DOWNLOAD_BASE/$ASSET" || fail "download failed: $DOWNLOAD_BASE/$ASSET"
    curl -fsSL --retry 3 -o "$TMP/SHA256SUMS" "$DOWNLOAD_BASE/SHA256SUMS" || fail "download failed: $DOWNLOAD_BASE/SHA256SUMS"
    log "Verifying checksum"
    EXPECTED="$(grep " $ASSET\$" "$TMP/SHA256SUMS" | awk '{print $1}' | head -n 1)"
    [ -n "$EXPECTED" ] || fail "no checksum for $ASSET in SHA256SUMS"
    ACTUAL="$(shasum -a 256 "$TMP/$ASSET" | awk '{print $1}')"
    [ "$EXPECTED" = "$ACTUAL" ] || fail "checksum mismatch (expected $EXPECTED, got $ACTUAL)"
fi

if [ -z "$APP_DIR" ]; then
    log "Installing to $BINARY"
    mkdir -p "$INSTALL_DIR"
    if [ -x "$BINARY" ]; then
        "$BINARY" service stop >/dev/null 2>&1 || true
    fi
    install -m 755 "$TMP/$ASSET" "$BINARY"
    xattr -d com.apple.quarantine "$BINARY" >/dev/null 2>&1 || true
fi

# A baked binary carries a signed trailer and enrolls itself; otherwise enroll explicitly.
if "$BINARY" bake-info >/dev/null 2>&1; then
    log "Branded build detected; it will enroll itself"
else
    log "Enrolling with $SERVER_URL"
    "$BINARY" enroll --server "$SERVER_URL" --token "$TOKEN"
fi

log "Installing background service"
"$BINARY" service install

log "Done. Check status with: remote-agent status"
log "Note: macOS will ask for Screen Recording and Accessibility permissions on first use."

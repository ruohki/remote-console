#!/bin/sh
# remote-agent installer for macOS — generated by remote-console.
# Usage: curl -fsSL "{{SERVER_URL}}/install.sh?token=…" | sudo sh
# Safe to run as root from an MDM / RMM (Jamf, NinjaOne, …) and to run again: an enrolled
# machine keeps its enrollment, the service is updated in place. Every failure exits non-zero.
set -eu

SERVER_URL="{{SERVER_URL}}"
TOKEN="{{TOKEN}}"
DOWNLOAD_BASE="{{DOWNLOAD_BASE}}"
USE_CONSOLE="{{USE_CONSOLE}}"
INSTALL_DIR="/usr/local/bin"
BINARY="$INSTALL_DIR/remote-agent"
# The release ships the bakeable binary under -base and a run-anywhere app beside it; the
# console serves the branded bundle, this is only the fallback when it has none.
ASSET="remote-agent-macos-universal-base"
LEGACY_ASSET="remote-agent-macos-universal"

# Colour only on a terminal; RMM logs get plain text.
if [ -t 2 ]; then BLUE='\033[1;34m'; RED='\033[1;31m'; RESET='\033[0m'; else BLUE=''; RED=''; RESET=''; fi
log()  { printf "${BLUE}==>${RESET} %s\n" "$*"; }
fail() { printf "${RED}error:${RESET} remote-agent install: %s\n" "$*" >&2; exit 1; }

[ "$(uname -s)" = "Darwin" ] || fail "this installer is for macOS; use install.ps1 on Windows"
[ "$(id -u)" -eq 0 ] || fail "run as root (sudo sh)"
command -v curl >/dev/null 2>&1 || fail "curl is required"

# Retries for flaky networks at boot; --retry-all-errors (curl 7.71+) also retries HTTP errors.
CURL_RETRY="--retry 5 --retry-delay 3"
if curl --help all 2>/dev/null | grep -q -- '--retry-all-errors'; then
    CURL_RETRY="$CURL_RETRY --retry-all-errors"
fi
fetch() { # url output
    # shellcheck disable=SC2086
    curl -fsSL $CURL_RETRY --connect-timeout 20 -o "$2" "$1" || fail "download failed: $1"
}

# System temp, not the caller's TMPDIR: root under an MDM has no meaningful user session.
TMP="$(mktemp -d /tmp/remote-agent.XXXXXX)" || fail "could not create a temporary directory"
trap 'rm -rf "$TMP"' EXIT

APP_DIR=""
if [ "$USE_CONSOLE" = "1" ]; then
    log "Downloading branded agent app from $SERVER_URL"
    fetch "$SERVER_URL/api/agent/download/macos-universal?token=$TOKEN" "$TMP/agent.zip"
    mkdir -p "$TMP/app"
    ditto -x -k "$TMP/agent.zip" "$TMP/app" || fail "could not unpack the downloaded app"
    APP_SRC="$(find "$TMP/app" -maxdepth 1 -name '*.app' | head -n 1)"
    [ -n "$APP_SRC" ] || fail "downloaded archive contains no .app bundle"
    APP_DIR="/Applications/$(basename "$APP_SRC")"
    log "Installing $APP_DIR"
    if [ -x "$APP_DIR/Contents/MacOS/remote-agent" ]; then
        "$APP_DIR/Contents/MacOS/remote-agent" service stop >/dev/null 2>&1 || true
    fi
    rm -rf "$APP_DIR"
    ditto "$APP_SRC" "$APP_DIR" || fail "could not copy the app to /Applications"
    xattr -dr com.apple.quarantine "$APP_DIR" >/dev/null 2>&1 || true
    # Keep the CLI reachable as `remote-agent`.
    mkdir -p "$INSTALL_DIR"
    ln -sfn "$APP_DIR/Contents/MacOS/remote-agent" "$BINARY" || fail "could not link $BINARY"
else
    fetch "$DOWNLOAD_BASE/SHA256SUMS" "$TMP/SHA256SUMS"
    # Releases from before the -base rename carry only the old name.
    EXPECTED="$(grep " $ASSET\$" "$TMP/SHA256SUMS" | awk '{print $1}' | head -n 1)"
    if [ -z "$EXPECTED" ]; then
        ASSET="$LEGACY_ASSET"
        EXPECTED="$(grep " $ASSET\$" "$TMP/SHA256SUMS" | awk '{print $1}' | head -n 1)"
    fi
    [ -n "$EXPECTED" ] || fail "no checksum for $ASSET in SHA256SUMS"
    log "Downloading $ASSET from $DOWNLOAD_BASE"
    fetch "$DOWNLOAD_BASE/$ASSET" "$TMP/$ASSET"
    log "Verifying checksum"
    ACTUAL="$(shasum -a 256 "$TMP/$ASSET" | awk '{print $1}')"
    [ "$EXPECTED" = "$ACTUAL" ] || fail "checksum mismatch (expected $EXPECTED, got $ACTUAL)"
fi

if [ -z "$APP_DIR" ]; then
    log "Installing to $BINARY"
    mkdir -p "$INSTALL_DIR"
    if [ -x "$BINARY" ]; then
        "$BINARY" service stop >/dev/null 2>&1 || true
    fi
    install -m 755 "$TMP/$ASSET" "$BINARY" || fail "could not install $BINARY"
    xattr -d com.apple.quarantine "$BINARY" >/dev/null 2>&1 || true
fi

# --if-needed: an installation already enrolled with this console keeps its enrollment and
# does not need the (possibly expired or used-up) token again.
if "$BINARY" enroll --help 2>/dev/null | grep -q -- '--if-needed'; then
    log "Enrolling with $SERVER_URL"
    "$BINARY" enroll --if-needed --server "$SERVER_URL" --token "$TOKEN" || fail "enrollment failed"
elif "$BINARY" bake-info >/dev/null 2>&1; then
    # Older agents: a branded build enrolls itself from its trailer.
    log "Branded build detected; it will enroll itself"
else
    log "Enrolling with $SERVER_URL"
    "$BINARY" enroll --server "$SERVER_URL" --token "$TOKEN" || fail "enrollment failed"
fi

log "Installing background service"
"$BINARY" service install || fail "service installation failed"

log "Done. Check status with: remote-agent status"
log "Note: macOS asks for Screen Recording and Accessibility permissions on first use (or grant them with a PPPC profile)."

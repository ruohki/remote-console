# remote-agent installer for Windows — generated by remote-console.
# Usage (administrator PowerShell): irm "{{SERVER_URL}}/install.ps1?token=…" | iex
$ErrorActionPreference = 'Stop'
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

$ServerUrl    = '{{SERVER_URL}}'
$Token        = '{{TOKEN}}'
$DownloadBase = '{{DOWNLOAD_BASE}}'
$UseConsole   = '{{USE_CONSOLE}}'   # comma list of console-available arches, e.g. "x86_64,aarch64"
$InstallDir   = Join-Path $env:ProgramFiles 'RemoteAgent'
$Binary       = Join-Path $InstallDir 'remote-agent.exe'

function Write-Step($msg) { Write-Host "==> $msg" -ForegroundColor Cyan }
function Fail($msg) { Write-Host "error: $msg" -ForegroundColor Red; exit 1 }

$principal = New-Object Security.Principal.WindowsPrincipal([Security.Principal.WindowsIdentity]::GetCurrent())
if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Fail "please run from an administrator PowerShell:  irm `"$ServerUrl/install.ps1?token=$Token`" | iex"
}

$arch = $env:PROCESSOR_ARCHITECTURE
if ($env:PROCESSOR_ARCHITEW6432) { $arch = $env:PROCESSOR_ARCHITEW6432 }
switch ($arch) {
    'AMD64' { $Asset = 'remote-agent-windows-x86_64.exe';  $Slug = 'windows-x86_64';  $ArchKey = 'x86_64' }
    'ARM64' { $Asset = 'remote-agent-windows-aarch64.exe'; $Slug = 'windows-aarch64'; $ArchKey = 'aarch64' }
    default { Fail "unsupported architecture: $arch" }
}
$Console = ($UseConsole -split ',') -contains $ArchKey

$Tmp = Join-Path $env:TEMP ("remote-agent-" + [Guid]::NewGuid().ToString('N'))
New-Item -ItemType Directory -Path $Tmp | Out-Null
try {
    if ($Console) {
        Write-Step "Downloading branded agent from $ServerUrl"
        Invoke-WebRequest -UseBasicParsing -Uri "$ServerUrl/api/agent/download/$Slug`?token=$Token" -OutFile (Join-Path $Tmp $Asset)
    } else {
        Write-Step "Downloading $Asset from $DownloadBase"
        Invoke-WebRequest -UseBasicParsing -Uri "$DownloadBase/$Asset" -OutFile (Join-Path $Tmp $Asset)
        Invoke-WebRequest -UseBasicParsing -Uri "$DownloadBase/SHA256SUMS" -OutFile (Join-Path $Tmp 'SHA256SUMS')
        Write-Step 'Verifying checksum'
        $line = Get-Content (Join-Path $Tmp 'SHA256SUMS') | Where-Object { $_ -match "\s$([regex]::Escape($Asset))$" } | Select-Object -First 1
        if (-not $line) { Fail "no checksum for $Asset in SHA256SUMS" }
        $expected = ($line -split '\s+')[0].ToLower()
        $actual = (Get-FileHash -Algorithm SHA256 (Join-Path $Tmp $Asset)).Hash.ToLower()
        if ($expected -ne $actual) { Fail "checksum mismatch (expected $expected, got $actual)" }
    }

    Write-Step "Installing to $Binary"
    New-Item -ItemType Directory -Force -Path $InstallDir | Out-Null
    if (Test-Path $Binary) {
        try { & $Binary service stop | Out-Null } catch { }
        Start-Sleep -Seconds 1
    }
    Copy-Item -Force (Join-Path $Tmp $Asset) $Binary

    $machinePath = [Environment]::GetEnvironmentVariable('Path', 'Machine')
    if (($machinePath -split ';') -notcontains $InstallDir) {
        [Environment]::SetEnvironmentVariable('Path', "$machinePath;$InstallDir", 'Machine')
    }

    # A baked binary carries a signed trailer and enrolls itself; otherwise enroll explicitly.
    & $Binary bake-info *> $null
    if ($LASTEXITCODE -eq 0) {
        Write-Step 'Branded build detected; it will enroll itself'
    } else {
        Write-Step "Enrolling with $ServerUrl"
        & $Binary enroll --server $ServerUrl --token $Token
        if ($LASTEXITCODE -ne 0) { Fail 'enrollment failed' }
    }

    Write-Step 'Installing Windows service'
    & $Binary service install
    if ($LASTEXITCODE -ne 0) { Fail 'service installation failed' }

    Write-Step 'Done. Check status with: remote-agent status'
} finally {
    Remove-Item -Recurse -Force $Tmp -ErrorAction SilentlyContinue
}

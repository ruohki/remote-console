# remote-agent installer for Windows — generated by remote-console.
# Usage (administrator PowerShell): irm "{{SERVER_URL}}/install.ps1?token=…" | iex
# Safe to run as SYSTEM from an RMM (Intune, NinjaOne, …) and to run again: an enrolled machine
# keeps its enrollment, the service is updated in place. Every failure exits non-zero.
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
[Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12

$ServerUrl    = '{{SERVER_URL}}'
$Token        = '{{TOKEN}}'
$DownloadBase = '{{DOWNLOAD_BASE}}'
$UseConsole   = '{{USE_CONSOLE}}'   # comma list of console-available arches, e.g. "x86_64,aarch64"
# 32-bit hosts (Intune's default PowerShell) see "Program Files (x86)" as ProgramFiles.
$ProgramRoot  = if ($env:ProgramW6432) { $env:ProgramW6432 } else { $env:ProgramFiles }
$InstallDir   = Join-Path $ProgramRoot 'RemoteAgent'
$Binary       = Join-Path $InstallDir 'remote-agent.exe'

function Write-Step($msg) { Write-Host "==> $msg" }
function Fail($msg) { Write-Host "error: remote-agent install: $msg"; exit 1 }

# Native commands are judged by their exit code. Windows PowerShell 5.1 turns their stderr
# into error records once output is captured (RMM agents do), which 'Stop' would make fatal.
function Invoke-Native([scriptblock]$Command) {
    $saved = $ErrorActionPreference
    $ErrorActionPreference = 'Continue'
    try { & $Command } finally { $ErrorActionPreference = $saved }
}

# Download with a few attempts: RMM fleets start at boot, when the network is often not up yet.
function Get-File($Uri, $OutFile) {
    for ($attempt = 1; $attempt -le 3; $attempt++) {
        try {
            Invoke-WebRequest -UseBasicParsing -Uri $Uri -OutFile $OutFile
            return
        } catch {
            $reason = $_.Exception.Message
            if ($attempt -lt 3) { Start-Sleep -Seconds (5 * $attempt) }
        }
    }
    Fail "download failed: $Uri ($reason)"
}

$principal = New-Object Security.Principal.WindowsPrincipal([Security.Principal.WindowsIdentity]::GetCurrent())
if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Fail "run from an administrator PowerShell or as SYSTEM"
}

$arch = $env:PROCESSOR_ARCHITECTURE
if ($env:PROCESSOR_ARCHITEW6432) { $arch = $env:PROCESSOR_ARCHITEW6432 }
switch ($arch) {
    'AMD64' { $Asset = 'remote-agent-windows-x86_64-base.exe'; $LegacyAsset = 'remote-agent-windows-x86_64.exe';  $Slug = 'windows-x86_64';  $ArchKey = 'x86_64' }
    'ARM64' { $Asset = 'remote-agent-windows-aarch64-base.exe'; $LegacyAsset = 'remote-agent-windows-aarch64.exe'; $Slug = 'windows-aarch64'; $ArchKey = 'aarch64' }
    default { Fail "unsupported architecture: $arch" }
}
$Console = ($UseConsole -split ',') -contains $ArchKey

# System temp, not the caller's profile: SYSTEM and fresh accounts may have none.
$TempRoot = Join-Path $env:SystemRoot 'Temp'
$Tmp = Join-Path $TempRoot ("remote-agent-" + [Guid]::NewGuid().ToString('N'))
try {
    New-Item -ItemType Directory -Path $Tmp | Out-Null

    if ($Console) {
        Write-Step "Downloading branded agent from $ServerUrl"
        Get-File "$ServerUrl/api/agent/download/$Slug`?token=$Token" (Join-Path $Tmp $Asset)
    } else {
        Get-File "$DownloadBase/SHA256SUMS" (Join-Path $Tmp 'SHA256SUMS')
        # Releases from before the -base rename carry only the old name.
        $sums = Get-Content (Join-Path $Tmp 'SHA256SUMS')
        if (-not ($sums | Where-Object { $_ -match "\s$([regex]::Escape($Asset))$" })) { $Asset = $LegacyAsset }
        Write-Step "Downloading $Asset from $DownloadBase"
        Get-File "$DownloadBase/$Asset" (Join-Path $Tmp $Asset)
        Write-Step 'Verifying checksum'
        $line = $sums | Where-Object { $_ -match "\s$([regex]::Escape($Asset))$" } | Select-Object -First 1
        if (-not $line) { Fail "no checksum for $Asset in SHA256SUMS" }
        $expected = ($line -split '\s+')[0].ToLower()
        $actual = (Get-FileHash -Algorithm SHA256 (Join-Path $Tmp $Asset)).Hash.ToLower()
        if ($expected -ne $actual) { Fail "checksum mismatch (expected $expected, got $actual)" }
    }

    Write-Step "Installing to $Binary"
    New-Item -ItemType Directory -Force -Path $InstallDir | Out-Null
    if (Test-Path $Binary) {
        Invoke-Native { & $Binary service stop *> $null }
        Start-Sleep -Seconds 2
    }
    $copied = $false
    for ($attempt = 1; $attempt -le 3 -and -not $copied; $attempt++) {
        try { Copy-Item -Force (Join-Path $Tmp $Asset) $Binary; $copied = $true }
        catch { Start-Sleep -Seconds 3 }
    }
    if (-not $copied) { Fail "could not replace $Binary (still running?)" }

    $machinePath = [Environment]::GetEnvironmentVariable('Path', 'Machine')
    if (($machinePath -split ';') -notcontains $InstallDir) {
        [Environment]::SetEnvironmentVariable('Path', "$machinePath;$InstallDir", 'Machine')
    }

    # --if-needed: an installation already enrolled with this console keeps its enrollment and
    # does not need the (possibly expired or used-up) token again.
    $help = Invoke-Native { (& $Binary enroll --help 2>&1) | Out-String }
    if ($help -match '--if-needed') {
        Write-Step "Enrolling with $ServerUrl"
        Invoke-Native { & $Binary enroll --if-needed --server $ServerUrl --token $Token }
        if ($LASTEXITCODE -ne 0) { Fail "enrollment failed (exit code $LASTEXITCODE)" }
    } else {
        # Older agents: a branded build enrolls itself from its trailer, a plain one explicitly.
        Invoke-Native { & $Binary bake-info *> $null }
        if ($LASTEXITCODE -eq 0) {
            Write-Step 'Branded build detected; it will enroll itself'
        } else {
            Write-Step "Enrolling with $ServerUrl"
            Invoke-Native { & $Binary enroll --server $ServerUrl --token $Token }
            if ($LASTEXITCODE -ne 0) { Fail "enrollment failed (exit code $LASTEXITCODE)" }
        }
    }

    Write-Step 'Installing Windows service'
    Invoke-Native { & $Binary service install }
    if ($LASTEXITCODE -ne 0) { Fail "service installation failed (exit code $LASTEXITCODE)" }

    Write-Step 'Done. Check status with: remote-agent status'
} catch {
    Fail $_.Exception.Message
} finally {
    Remove-Item -Recurse -Force $Tmp -ErrorAction SilentlyContinue
}

# ── Public URL & transport ──────────────────────────────────────────────────────
# Public URL of the console (used by agents, install scripts and cookies). MUST be https://
# outside localhost / private networks; the console refuses to start otherwise unless
# ALLOW_INSECURE_PUBLIC_URL=1 is set (never in production).
CONSOLE_PUBLIC_URL=https://remote.example.com
#ALLOW_INSECURE_PUBLIC_URL=0
# Set to 1 only when a reverse proxy in front of the console sets X-Forwarded-For /
# X-Forwarded-Proto (docker-compose does). Without it those headers are ignored.
TRUST_PROXY=1

# ── Secrets at rest ─────────────────────────────────────────────────────────────
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts the bakery signing key in the
# database. Keep it out of the database backup; losing it means agents must re-enroll after
# a new key is generated.
CONSOLE_MASTER_KEY=change-me-to-openssl-rand-base64-32

# Login session lifetime in hours (absolute; sessions also expire after 12 h without use)
SESSION_TTL_HOURS=168

# ── Sign-in policy ──────────────────────────────────────────────────────────────
# Who must enrol a second factor (authenticator app or passkey) before using the console:
# admins (default) | all | off
REQUIRE_2FA=admins
# Set to 0 to disable password sign-in for everyone except accounts flagged "break_glass"
# (PATCH /api/users/:id { "break_glass": true }). Requires at least one such administrator;
# the console refuses to start otherwise. OIDC / SAML / LDAP / passkeys keep working.
LOCAL_LOGIN=1
# OIDC, SAML and LDAP are configured in the admin UI (Settings → Authentication); their
# secrets are encrypted with CONSOLE_MASTER_KEY.

# ── Outgoing email ──────────────────────────────────────────────────────────────
# SMTP (host, port, STARTTLS/TLS, credentials, sender) is configured in the admin UI
# (Settings → Email), not here; the SMTP password is sealed with CONSOLE_MASTER_KEY and
# changes apply without a restart. Email enables two features:
#   * "Forgot password" links — only for local (password) accounts while LOCAL_LOGIN=1;
#     SSO/LDAP users reset their password at the identity provider.
#   * One-time codes sent by email as a second factor (next to authenticator apps and
#     passkeys). If SMTP is disabled later, users whose only factor is email cannot sign
#     in (503 second_factor_unavailable) until it is fixed or an admin resets their 2FA.

# ── TLS pinning (optional) ──────────────────────────────────────────────────────
# Public-key pin published in /api/info (agents will pin it). Either the certificate PEM
# (the SPKI digest is computed at startup) or the digest itself.
#CONSOLE_TLS_CERT_PEM=/etc/letsencrypt/live/remote.example.com/fullchain.pem
#CONSOLE_TLS_SPKI_SHA256=base64-of-sha256-over-SubjectPublicKeyInfo

# ── Agents ──────────────────────────────────────────────────────────────────────
# Where install scripts download agent binaries from (fallback when no base binary is baked)
AGENT_DOWNLOAD_BASE=https://github.com/ruohki/remote-agent/releases/latest/download

# Optional: directory with base agent binaries the console bakes branding into
# (files named remote-agent-macos-universal, remote-agent-windows-x86_64.exe,
#  remote-agent-windows-aarch64.exe). When unset, base binaries are fetched from
# AGENT_DOWNLOAD_BASE and cached under data/agent-cache/.
#AGENT_BINARY_DIR=/opt/remote-agent-binaries

# Optional code signing of baked macOS app bundles.
# On a macOS host: a "Developer ID Application" identity in the keychain and a notarytool
# keychain profile (create it once with: xcrun notarytool store-credentials remote-console).
#MACOS_SIGN_IDENTITY="Developer ID Application: Example Corp (TEAMID1234)"
#MACOS_NOTARY_PROFILE=remote-console
# On Linux/Docker: rcodesign (https://github.com/indygreg/apple-platform-rs) with the same
# certificate exported as .p12 and an App Store Connect API key file.
#MACOS_SIGN_P12=/secrets/developer-id.p12
# Or pass the certificate as text (base64) when the host cannot mount a binary file:
#MACOS_SIGN_P12_BASE64=MIIN...
# A file mounted at MACOS_SIGN_P12 may hold that same base64 instead of the raw .p12.
#MACOS_SIGN_P12_PASSWORD=change-me
# …or keep the password out of the environment (Docker/Kubernetes secret):
#MACOS_SIGN_P12_PASSWORD_FILE=/secrets/developer-id.password
#APPLE_API_KEY_JSON=/secrets/app-store-connect.json
# Reserved: Authenticode signing of Windows agents (not applied yet).
#WINDOWS_SIGN_PFX=/secrets/codesign.pfx
#WINDOWS_SIGN_PFX_PASSWORD=change-me

# ── STUN / TURN ─────────────────────────────────────────────────────────────────
# Own relay (coturn, see docker-compose.yml): generate with openssl rand -hex 32.
TURN_SECRET=change-me
# Hosted relay instead: the fixed username/password it issues. Both must be set, and
# TURN_SECRET must be unset or they are ignored. Every session gets the same pair, so it
# cannot be revoked per session — prefer your own coturn where you can.
#TURN_USERNAME=000000000000000000
#TURN_PASSWORD=change-me
# DNS name of the relay (must match its TLS certificate, see coturn/README.md)
TURN_HOST=turn.example.com
# Public IP coturn advertises (external-ip)
TURN_PUBLIC_IP=203.0.113.10
TURN_REALM=remote
# Plain TURN on 3478/udp plus TURN-over-TLS on 443/tcp (the firewall-proof fallback).
TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:443?transport=tcp
# Use your own relay for STUN as well so no third party sees your agents' addresses.
STUN_URLS=stun:turn.example.com:3478

# Log filter
RUST_LOG=info
